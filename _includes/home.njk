{# Home: hexagon tiles in a ring around a photo slideshow. Layout data in _data/home.yml. #}
<div class="ring" style="aspect-ratio: {{ home.ring.width }} / {{ home.ring.height }}; --tile: {{ home.ring.tile }}%">
  {%- for t in home.tiles %}
  <a class="tile" href="{{ t.url | langUrl(lang) }}" style="left: {{ t.x }}%; top: {{ t.y }}%">
    <img src="{{ t.img }}" alt="{{ nav | navLabel(t.url, lang) }}" width="159" height="139" sizes="(max-width: 639px) 25vw, 130px">
    <img class="tile__hover" src="{{ t.hover }}" alt="" width="159" height="139" sizes="(max-width: 639px) 25vw, 130px">
  </a>
  {%- endfor %}
  <div class="slideshow" aria-label="{{ '研究成果照片' if lang == 'zh' else 'Our robots' }}" role="img">
    {%- for s in home.slides %}
    <img src="{{ s.img }}" alt="{{ s.caption }}" style="--i: {{ loop.index0 }}" sizes="(max-width: 639px) 100vw, 540px"{% if loop.first %} loading="eager" fetchpriority="high"{% endif %}>
    {%- endfor %}
  </div>
</div>
<section class="latest" aria-labelledby="latest-title">
  <h2 id="latest-title">{{ i18n.latest_news[lang] }}</h2>
  <ul class="news">
    {%- for item in news | latestNews(3) %}
    {%- set text = item.en if (lang == 'en' and item.en) else item.text %}
    <li{% if lang == 'en' and not item.en %} lang="zh-Hant-TW"{% endif %}>
      {%- if item.date %}<span class="news__date">{{ item.date }}</span> {% endif %}{{ text | mdInline | safe -}}
    </li>
    {%- endfor %}
  </ul>
  <p><a href="{{ 'news.html' | langUrl(lang) }}">{{ i18n.all_news[lang] }} →</a></p>
</section>

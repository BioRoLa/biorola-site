<div class="floorplan">
  <img src="/pic/nlab tour.png" alt="{{ '實驗室平面圖' if lang == 'zh' else 'Lab floor plan' }}" width="1600" height="1381">
  {%- for s in spots %}
  <a class="floorplan__spot" href="#tour-{{ loop.index }}" style="left: {{ s.x }}%; top: {{ s.y }}%; width: {{ s.d }}%" aria-label="{{ s[lang] }}"></a>
  {%- endfor %}
</div>
<div class="tour-photos">
  {%- for s in spots %}
  <figure id="tour-{{ loop.index }}">

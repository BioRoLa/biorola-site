{%- for g in movies %}
<h2>{{ g.title | localize(lang) }}</h2>
<div class="videos">
  {%- for v in g.videos %}
  <figure class="video">
    <iframe src="https://www.youtube-nocookie.com/embed/{{ v.youtube }}" title="{{ g.title | localize(lang) }}{% if v.title %}: {{ v.title | localize(lang) }}{% endif %}" loading="lazy"
            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen></iframe>
    {%- if v.title %}<figcaption>{{ v.title | localize(lang) }}</figcaption>{% endif %}
  </figure>
  {%- endfor %}
</div>
{%- endfor %}

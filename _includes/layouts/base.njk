<!doctype html>
<html lang="{{ 'zh-Hant-TW' if lang == 'zh' else 'en' }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if pageTitle %}{{ pageTitle }} | {% endif %}{{ site.short_name }} {{ site.name[lang] }}</title>
  {%- set fullTitle = (pageTitle ~ " | " if pageTitle else "") ~ site.short_name ~ " " ~ site.name[lang] %}
  {%- set desc = description or site.description[lang] %}
  {%- set canonical = site.url ~ (pageUrl | langUrl(lang)) %}
  <meta name="description" content="{{ desc }}">
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.short_name }} {{ site.name[lang] }}">
  <meta property="og:title" content="{{ fullTitle }}">
  <meta property="og:description" content="{{ desc }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:image" content="{{ site.url }}{{ (shareImage or site.share_image) | replace(" ", "%20") }}">
  <meta property="og:locale" content="{{ 'zh_TW' if lang == 'zh' else 'en_US' }}">
  <meta property="og:locale:alternate" content="{{ 'en_US' if lang == 'zh' else 'zh_TW' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#000000">
  <meta name="color-scheme" content="light dark">
  <link rel="icon" href="/pic/home/favicon.ico">
  <link rel="stylesheet" href="/assets/css/site.css">
  <script>document.documentElement.classList.replace("no-js", "js");</script>
  <script src="/assets/js/menu.js" defer></script>
  <link rel="alternate" hreflang="zh-Hant-TW" href="{{ site.url }}{{ pageUrl | langUrl('zh') }}">
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ pageUrl | langUrl('en') }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ pageUrl | langUrl('zh') }}">
</head>
<body>
  <a class="skip-link" href="#main">{{ '跳到主要內容' if lang == 'zh' else 'Skip to content' }}</a>
  <div class="frame">
    <header class="masthead">
      <a href="{{ 'index.html' | langUrl(lang) }}">
        <img src="/pic/logo/logo.png" loading="eager" fetchpriority="high" sizes="(max-width: 1056px) 100vw, 1056px"
             alt="BioRoLa · {{ site.name.en }} · {{ site.affiliation.en }}">
      </a>
    </header>

    <nav class="menu" aria-label="{{ '主選單' if lang == 'zh' else 'Main' }}">
      <button class="menu__toggle" type="button" aria-expanded="false" aria-controls="menu-bar">
        <span aria-hidden="true">☰</span> {{ '選單' if lang == 'zh' else 'Menu' }}
      </button>
      <ul class="menu__bar" id="menu-bar">
        {%- for section in nav %}
        {%- set first = section.url or section.groups[0].pages[0].url %}
        <li class="menu__item{% if section.id == currentSection %} is-current{% endif %}">
          <a href="{{ first | langUrl(lang) }}">{{ section.label[lang] }}</a>
          {%- set groups = section.groups | default([]) %}
          {%- if groups | length > 1 or (groups | length == 1 and groups[0].pages | length > 1) %}
          <button class="menu__expand" type="button" aria-expanded="false"
                  aria-label="{{ section.label[lang] }}{{ '：展開子選單' if lang == 'zh' else ': show submenu' }}"><span aria-hidden="true">▾</span></button>
          {%- endif %}
          {%- if groups | length > 1 %}
          <ul class="menu__drop">
            {%- for group in groups %}
            <li>
              <a href="{{ group.pages[0].url | langUrl(lang) }}">{{ group.label[lang] }}</a>
              {%- if section.id == 'research' %}
              <ul class="menu__fly">
                {%- for p in group.pages %}<li><a href="{{ p.url | langUrl(lang) }}">{{ p.label[lang] }}</a></li>{% endfor %}
              </ul>
              {%- endif %}
            </li>
            {%- endfor %}
          </ul>
          {%- elif groups | length == 1 and groups[0].pages | length > 1 %}
          <ul class="menu__drop">
            {%- for p in groups[0].pages %}<li><a href="{{ p.url | langUrl(lang) }}">{{ p.label[lang] }}</a></li>{% endfor %}
          </ul>
          {%- endif %}
        </li>
        {%- endfor %}
        <li class="menu__lang">
          {%- if lang == 'zh' %}
          <a href="{{ pageUrl | langUrl('en') }}" hreflang="en" lang="en">English</a>
          {%- else %}
          <a href="{{ pageUrl | langUrl('zh') }}" hreflang="zh-Hant-TW" lang="zh-Hant-TW">中文</a>
          {%- endif %}
        </li>
      </ul>
    </nav>

    <main id="main" tabindex="-1">
      {{ content | safe }}
    </main>

    <footer class="footer">
      <div class="footer__cols">
        <p>
          <strong>{{ site.short_name }} · {{ site.name[lang] }}</strong><br>
          {{ site.affiliation[lang] }}<br>
          {{ site.address[lang] }}
        </p>
        <p>
          {{ 'Lab phone' if lang == 'en' else '實驗室電話' }}: {{ site.phone }}<br>
          Email: <a href="mailto:{{ site.email }}">{{ site.email }}</a><br>
          <a href="{{ 'aboutus_contactus.html' | langUrl(lang) }}">{{ '聯絡我們' if lang == 'zh' else 'Contact us' }}</a>
        </p>
      </div>
      <p class="footer__copy">© {{ build.year }} {{ site.name[lang] }}</p>
    </footer>
  </div>
</body>
</html>

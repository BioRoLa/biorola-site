{%- from "members/macros.njk" import card %}
<figure class="group-photo">
  <img src="/membersinfo/profile/stu_welcome10.JPG" sizes="(max-width: 639px) 100vw, 568px" alt="{{ '實驗室成員合照' if lang == 'zh' else 'Lab group photo' }}">
</figure>
{%- for degree in ['phd', 'ms'] %}
<h2>{{ i18n[degree ~ '_students'][lang] }}</h2>
<ul class="cards cards--people">
  {%- for m in members | currentStudents(degree) %}
  <li>{{ card(m, lang) }}</li>
  {%- endfor %}
</ul>
{%- endfor %}
